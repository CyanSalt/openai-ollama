{
  "name": "openai-ollama",
  "version": "0.1.0-beta.5",
  "description": "Create a local Ollama proxy service for the OpenAI compatible backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --fix './**/*.{js,ts}'",
    "lint:ci": "eslint --max-warnings 0 './**/*.{js,ts}'",
    "prepack": "tsdown",
    "release": "release-it --preRelease=beta --npm.tag=latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/openai-ollama.git"
  },
  "keywords": [
    "openai",
    "ollama"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CyanSalt/openai-ollama/issues"
  },
  "homepage": "https://github.com/CyanSalt/openai-ollama#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "error"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "release-it": "^20.0.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "eventsource-parser": "^3.0.8",
    "h3": "^1.15.11",
    "mri": "^1.2.0",
    "ofetch": "^1.5.1",
    "zod": "^4.4.3"
  }
}
